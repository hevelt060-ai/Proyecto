NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
USE_MONGODB=false
MONGODB_DATABASE=erp_dev

# Development: local MongoDB replica set (transactions enabled)
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Atlas example only: provide the real URI through an untracked .env or secret manager.
# MONGODB_URI=mongodb+srv://<cluster-host>/<database>?retryWrites=true&w=majority

# Redis is optional in development; it must never be the source of truth.
# REDIS_URL=redis://127.0.0.1:6379

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Secrets: never commit real values. Required in production.
SESSION_SECRET=
PASSWORD_PEPPER=

# S3-compatible object storage metadata adapter.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
