NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
USE_MONGODB=false
MONGODB_DATABASE=erp

# Development: local MongoDB replica set (transactions enabled)
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB_NAME=erp
# Staging/Production: MongoDB Atlas
# MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/erp?retryWrites=true&w=majority

# Redis is optional in development; it must never be the source of truth.
# REDIS_URL=redis://127.0.0.1:6379

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Secrets: never commit real values. Required in production.
JWT_SECRET=
SESSION_SECRET=
PASSWORD_PEPPER=

# S3-compatible object storage metadata adapter.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
